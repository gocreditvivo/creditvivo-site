# Credit Vivo Proprietary Scanner Backend
# No paid AI API required.

CREDIT_VIVO_ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app,https://creditvivo.com
SCANNER_ENVIRONMENT=development
SCANNER_MAX_FILES=3
SCANNER_MAX_FILE_MB=25
SCANNER_RETAIN_UPLOADS=false
SCANNER_WRITE_RAW_TEXT=false
SCANNER_STORAGE_DIR=
APP_ENV=local

# Staging/UAT safe-mode controls
SCANNER_USE_SYNTHETIC_REPORTS=false
SCANNER_ALLOW_REAL_CUSTOMER_DATA=true
ENABLE_AUTO_SEND=false
ENABLE_CUSTOMER_FINAL_RESULT_WITHOUT_QA=false
ENABLE_LETTERS_WITHOUT_VERIFIED_ISSUE=false
ENABLE_COMPLAINTS_WITHOUT_APPROVAL=false
ENABLE_ATTORNEY_ESCALATION_WITHOUT_APPROVAL=false
ENABLE_EXTERNAL_CALLS=false
ENABLE_PAYMENT_BEFORE_COMPLIANCE_APPROVAL=false
PAYMENTS_MODE=disabled
STRIPE_MODE=disabled

# Founder/admin backend login
CREDITVIVO_ADMIN_USERNAME=founder@creditvivo.local
CREDITVIVO_ADMIN_PASSWORD=change-this-long-random-password
ADMIN_SESSION_SECRET=change-this-long-random-session-secret
ADMIN_SETUP_TOKEN=change-this-owner-only-setup-token

# Production readiness gates
CREDITVIVO_AUTH_PROVIDER=local-dev
CREDITVIVO_STORAGE_ENCRYPTION_KEY=change-this-32-byte-or-longer-secret

# Production email structure, no-send defaults
EMAIL_PROVIDER=disabled
EMAIL_FROM=no-reply@creditvivo.com
SUPPORT_EMAIL=support@creditvivo.com
PRIVACY_EMAIL=privacy@creditvivo.com
SECURITY_EMAIL=security@creditvivo.com
SOCIAL_EMAIL=social@creditvivo.com
ENABLE_EMAIL_SENDING=false
ENABLE_MARKETING_EMAILS=false
ENABLE_DISPUTE_EMAIL_AUTO_SEND=false
EMAIL_API_KEY=
EMAIL_WEBHOOK_SECRET=

# Live site links shown inside the backend hub
LIVE_CREDITVIVO_HOME_URL=https://www.creditvivo.com/
LIVE_CREDITVIVO_SCAN_URL=https://www.creditvivo.com/scan
LIVE_CREDITVIVO_LOGIN_URL=https://www.creditvivo.com/dashboard
