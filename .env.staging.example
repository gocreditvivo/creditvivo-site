# Credit Vivo Staging / UAT

APP_ENV=staging
NODE_ENV=production

# Frontend
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_CREDIT_VIVO_DEMO_MODE=false
NEXT_PUBLIC_CREDIT_VIVO_REQUIRE_PRODUCTION_GATES=true
NEXT_PUBLIC_CREDIT_VIVO_REQUIRE_AUTH=true
NEXT_PUBLIC_CREDIT_VIVO_API_BASE_URL=http://127.0.0.1:8082

# Mock / synthetic test data
SCANNER_MODE=staging_safe
SCANNER_USE_SYNTHETIC_REPORTS=true
SCANNER_ALLOW_REAL_CUSTOMER_DATA=false

# Scanner safety
ENABLE_AUTO_SEND=false
ENABLE_CUSTOMER_FINAL_RESULT_WITHOUT_QA=false
ENABLE_LETTERS_WITHOUT_VERIFIED_ISSUE=false
ENABLE_COMPLAINTS_WITHOUT_APPROVAL=false
ENABLE_ATTORNEY_ESCALATION_WITHOUT_APPROVAL=false
ENABLE_EXTERNAL_CALLS=false

# Payments
PAYMENTS_MODE=test
STRIPE_MODE=test
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=sandbox
EMAIL_FROM=no-reply@creditvivo.com
SUPPORT_EMAIL=support@creditvivo.com
PRIVACY_EMAIL=privacy@creditvivo.com
SECURITY_EMAIL=security@creditvivo.com
ENABLE_EMAIL_SENDING=false
ENABLE_MARKETING_EMAILS=false
ENABLE_DISPUTE_EMAIL_AUTO_SEND=false

# Data
DATABASE_URL=
REDIS_URL=
ENCRYPTION_KEY=
AUDIT_LOG_ENABLED=true

# Upload safety
MAX_UPLOAD_MB=50
ALLOWED_FILE_TYPES=.pdf,.png,.jpg,.jpeg,.txt
BLOCKED_FILE_TYPES=.exe,.bat,.cmd,.ps1,.js,.vbs,.zip,.rar,.7z

# Production gates
REQUIRE_HEALTH_CHECK=true
REQUIRE_GROUND_TRUTH_VALIDATION=true
REQUIRE_QA_VERIFICATION=true
REQUIRE_SECURITY_AUDIT=true
REQUIRE_PRODUCTION_GATE=true

