# Credit Vivo production environment template.
# Never commit real secrets, tokens, customer credit reports, IDs, or payment keys.

NEXT_PUBLIC_SITE_URL=https://www.creditvivo.com
NEXT_PUBLIC_GA_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SCANNER_ENVIRONMENT=staging
SCANNER_WRITE_RAW_TEXT=false
SCANNER_RETAIN_UPLOADS=false
SCANNER_RETAIN_OUTPUTS=false
SCANNER_MAX_CONCURRENT=2
SCANNER_MAX_SCANS_PER_USER_MINUTE=5
SCANNER_REQUEST_DEADLINE_SECONDS=50
ENABLE_PUBLIC_EVENT_INGEST=false
ENABLE_PUBLIC_LEAD_CAPTURE=false
ENABLE_SKY_BELL_PROXY=false
INTERNAL_OPS_API_TOKEN=
SKY_BELL_ALLOWED_PATHS=

# Vercel Connect: the sky-bell connector token is fetched automatically via
# VERCEL_OIDC_TOKEN on Vercel deployments (see api/sky-bell.js). No manual
# secret needed there. Only set this if the connector's base URL ever changes:
# SKY_BELL_BASE_URL=https://api.perplexity.ai/sky-bell

# Future production providers:
# AUTH_PROVIDER_CLIENT_ID=
# AUTH_PROVIDER_CLIENT_SECRET=
# PAYMENT_PROVIDER_SECRET_KEY=
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
# ENCRYPTED_STORAGE_BUCKET=
